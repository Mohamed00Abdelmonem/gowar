# Backend API Integration
# Set VITE_USE_BACKEND_API=true when running the Django + PostgreSQL/PostGIS backend locally or in Docker
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_USE_BACKEND_API=false

# Geocoding provider (OpenStreetMap Nominatim by default, no API key required)
VITE_GEOCODING_URL=https://nominatim.openstreetmap.org
