# =============================================================================
# Gowar Production Environment Template (/opt/gowar/.env on Contabo VPS)
# =============================================================================
# IMPORTANT:
#   1. Copy this file to /opt/gowar/.env on the VPS (chmod 600 /opt/gowar/.env).
#   2. Never commit real secrets to Git.
#   3. Preserve your EXISTING PostgreSQL credentials in /opt/gowar/.env —
#      do NOT change POSTGRES_PASSWORD unless you also update the existing DB user.
#   4. Missing or placeholder values for required variables will cause Django
#      to fail fast on startup with a clear ImproperlyConfigured error.
# =============================================================================

# --- Django Core (REQUIRED) ---
DJANGO_SETTINGS_MODULE=config.settings.prod
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace-with-a-64-char-random-secret-key
DEBUG=False
TIME_ZONE=Africa/Cairo
DJANGO_LOG_LEVEL=INFO

# --- Domain, Hosts, CORS & CSRF (REQUIRED) ---
# Comma-separated hostnames without scheme (no https://)
ALLOWED_HOSTS=YOUR_DOMAIN,www.YOUR_DOMAIN,delivery.YOUR_DOMAIN
# Comma-separated full origins WITH https://
CORS_ALLOWED_ORIGINS=https://YOUR_DOMAIN,https://www.YOUR_DOMAIN,https://delivery.YOUR_DOMAIN
CSRF_TRUSTED_ORIGINS=https://YOUR_DOMAIN,https://www.YOUR_DOMAIN,https://delivery.YOUR_DOMAIN

# --- HTTPS & Security ---
# Set to False temporarily ONLY while testing plain HTTP before Certbot SSL is enabled.
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
# Keep False in production unless you intentionally want Swagger/ReDoc exposed
GOWAR_ENABLE_API_DOCS=False

# --- Existing PostgreSQL + PostGIS Container (REQUIRED) ---
# Must match the existing gowar-db container on gowar_db_net.
POSTGRES_DB=gowar_db
POSTGRES_USER=gowar_user
POSTGRES_PASSWORD=replace-with-existing-gowar-db-password
POSTGRES_HOST=gowar-db
POSTGRES_PORT=5432
DB_CONN_MAX_AGE=60

# --- JWT Lifetimes ---
JWT_ACCESS_TOKEN_MINUTES=30
JWT_REFRESH_TOKEN_DAYS=7

# --- Upload Limits (bytes, keep aligned with Nginx client_max_body_size 20M) ---
DATA_UPLOAD_MAX_MEMORY_SIZE=20971520
FILE_UPLOAD_MAX_MEMORY_SIZE=10485760

# --- Email (Optional SMTP; falls back to console logs if EMAIL_HOST is empty) ---
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=no-reply@YOUR_DOMAIN
SERVER_EMAIL=no-reply@YOUR_DOMAIN

# --- Error Monitoring (Optional Sentry) ---
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# --- Web Push Notifications (VAPID) ---
# Generate keys with:
#   python3 -c "from py_vapid import Vapid; v=Vapid(); v.generate_keys(); print('PUBLIC:', v.public_key_urlsafe_base64()); print('PRIVATE:', v.private_key_urlsafe_base64())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_EMAIL=mailto:admin@YOUR_DOMAIN

# --- Frontend Build / Geocoding ---
# OpenStreetMap Nominatim is used by default (no API key required)
VITE_GEOCODING_URL=https://nominatim.openstreetmap.org

# --- Payments ---
# Gowar currently operates with Cash on Delivery (cod).
# No third-party online payment gateway credentials are required yet.

# --- Docker Deployment Settings (used by docker-compose.prod.yml & scripts) ---
APP_BIND_PORT=8080
GOWAR_ENV_FILE=/opt/gowar/.env
GOWAR_BACKEND_IMAGE=gowar-backend:latest
GOWAR_FRONTEND_IMAGE=gowar-frontend:latest
