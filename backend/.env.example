# Django Core
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=replace-with-a-long-random-secret-key-at-least-50-chars
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
TIME_ZONE=Africa/Cairo

# PostgreSQL + PostGIS
POSTGRES_DB=gowar_db
POSTGRES_USER=gowar_user
POSTGRES_PASSWORD=replace-with-strong-db-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# CORS & CSRF
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# JWT Lifetimes (minutes / days)
JWT_ACCESS_TOKEN_MINUTES=30
JWT_REFRESH_TOKEN_DAYS=7

# Development Seed Controls (NEVER enable demo passwords in production)
GOWAR_ENABLE_DEMO_SEED=true
DEMO_ADMIN_EMAIL=admin@gowar.demo
DEMO_ADMIN_PASSWORD=Admin@123
DEMO_MERCHANT_PASSWORD=Gowar@123
DEMO_CUSTOMER_PASSWORD=Customer@123
