# Host Nginx configuration (Step 1: HTTP bootstrap before Let's Encrypt SSL)
# Copy to: /etc/nginx/sites-available/gowar
# Replace YOUR_DOMAIN with your actual domain name (e.g. gowar.eg).
# Test before reload: sudo nginx -t && sudo systemctl reload nginx

server {
    listen 80;
    listen [::]:80;
    server_name YOUR_DOMAIN www.YOUR_DOMAIN;

    server_tokens off;
    client_max_body_size 20M;

    # Let's Encrypt HTTP-01 ACME challenge
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 10s;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }
}
